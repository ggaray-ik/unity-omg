# This .gitignore file should be placed at the root of your Unity project

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# MemoryCaptures can get excessive in size
MemoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is ignored
!/[Aa]ssets/**/*.meta

# Ignore Rider files
.idea/
*.sln.iml

# Ignore Visual Studio files
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated VS Code files
.vscode/

# Crash reports
sysinfo.txt

# macOS
.DS_Store

# Windows
Thumbs.db

# Autogenerated Jetbrains Rider plugin
Assets/Plugins/Editor/JetBrains*

# Addressables
ServerData/

# Android
.gradle/

# Ignore generated builds
*.apk
*.aab
*.unitypackage

# Optional: recordings
Recordings/

# Optional: backups
Backup*/
Backups*/

# Ignore test coverage results
CoverageResults/